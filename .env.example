# ---------------------------------------------------------------------------
# Telegram Mini App — environment configuration
# Copy to `.env` and fill in. Every value is optional: the app falls back to
# public endpoints and to the bundled offline snapshot when a key is missing.
# Only VITE_-prefixed vars are exposed to the client bundle.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
VITE_APP_VERSION=1.0.0

# --- TON Connect -----------------------------------------------------------
# Public URL of tonconnect-manifest.json (must be reachable over HTTPS).
# In dev the bundled /tonconnect-manifest.json is used automatically.
VITE_TONCONNECT_MANIFEST_URL=https://your-domain.example/tonconnect-manifest.json

# TON RPC endpoint used to read the connected wallet's on-chain balance.
# Free tier keys: https://toncenter.com
VITE_TONCENTER_API_BASE=https://toncenter.com/api/v2
VITE_TONCENTER_API_KEY=

# --- Crypto prices (CoinGecko) ---------------------------------------------
# Leave the key blank to use the free public API (heavily rate-limited:
# ~10-30 req/min). With a Demo/Pro key set the matching base URL below.
#   Demo key  -> https://api.coingecko.com/api/v3
#   Pro key   -> https://pro-api.coingecko.com/api/v3
VITE_COINGECKO_API_BASE=https://api.coingecko.com/api/v3
VITE_COINGECKO_API_KEY=

# --- FX rates --------------------------------------------------------------
# Supported values: er-api | exchangerate-host | open
#   er-api            -> open.er-api.com, no key required (default)
#   exchangerate-host -> api.exchangerate.host, now requires an access key
#   open              -> openexchangerates.org, requires an app id
VITE_FX_PROVIDER=er-api
VITE_FX_API_BASE=https://open.er-api.com/v6
VITE_FX_API_KEY=

# --- Polling ---------------------------------------------------------------
# How often live rates refresh while the app is open (milliseconds).
# The spec asks for 30-60s; keep it >= 30000 to stay rate-limit friendly.
VITE_RATES_REFRESH_MS=45000

# --- Support & legal -------------------------------------------------------
VITE_SUPPORT_URL=https://t.me/vortex_fallet_support
VITE_TERMS_URL=https://matveyforgeon.github.io/telegram-wallet-tos/Vortex_Fallet_Legal_Terms_and_Privacy.pdf

# --- Transaction notifications ---------------------------------------------
# Endpoint of your notify relay (see server/notify-bot.mjs). Leave blank to
# disable Telegram-chat notifications entirely.
#
# The bot token NEVER belongs here: everything VITE_-prefixed ships inside the
# client bundle and can be read by any user. The relay holds the token.
VITE_NOTIFY_ENDPOINT=
# Sends Telegram's signed initData so the relay can verify who is asking.
VITE_NOTIFY_SEND_INIT_DATA=true
